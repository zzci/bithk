{
  "name": "@app/api",
  "type": "module",
  "version": "0.3.13",
  "private": true,
  "description": "Hono API on Bun with Drizzle SQLite storage.",
  "homepage": "https://github.com/zzci",
  "repository": {
    "type": "git",
    "url": "https://github.com/zzci/bun-app-tpl.git",
    "directory": "apps/api"
  },
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "nsl run --name \"${APP_NAME:-bit}:${BASE_PATH:-}/api\" bun --watch --env-file=../../.env src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --minify",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun --env-file=/dev/null test",
    "test:coverage": "bun --env-file=/dev/null test --coverage",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "seed": "bun --env-file=../../.env run scripts/seed/seed.ts",
    "gen:api-docs": "bun scripts/gen-api-docs.ts",
    "check:api-docs": "bun scripts/gen-api-docs.ts --check",
    "gen:api-spec": "bun scripts/gen-api-spec.ts",
    "check:api-spec": "bun scripts/gen-api-spec.ts --check"
  },
  "dependencies": {
    "@hono/standard-validator": "0.4.0",
    "@standard-community/standard-json": "0.3.5",
    "@standard-community/standard-openapi": "0.2.9",
    "@types/nodemailer": "8.0.1",
    "cac": "7.0.0",
    "consola": "3.4.2",
    "cronbake": "0.4.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "hono-openapi": "1.3.1",
    "nanoid": "6.0.1",
    "nodemailer": "9.1.1",
    "oauth4webapi": "3.8.7",
    "openapi-types": "12.1.3",
    "otpauth": "9.5.1",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "tar-stream": "3.2.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@app/tsconfig": "workspace:*",
    "@types/bun": "1.4.0",
    "@types/qrcode": "1.5.6",
    "@types/smtp-server": "3.5.13",
    "drizzle-kit": "0.31.10",
    "smtp-server": "3.19.6",
    "typescript": "catalog:"
  }
}
