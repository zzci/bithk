{
  "name": "@app/monorepo",
  "type": "module",
  "version": "0.3.13",
  "private": true,
  "description": "Bun monorepo template for OAuth-backed internal workspaces.",
  "engines": {
    "bun": "1.4.0",
    "node": "24.14.x"
  },
  "homepage": "https://github.com/zzci",
  "repository": {
    "type": "git",
    "url": "https://github.com/zzci/bun-app-tpl.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "scripts": {
    "dev": "bun --env-file=.env run --filter '@app/*' dev",
    "dev:all": "bun scripts/dev-all.ts",
    "dev:dex": "bun scripts/dev-dex.ts",
    "build": "bun run --filter '*' build",
    "lint": "eslint apps/ scripts/ tests/ eslint.config.ts --ext .ts,.tsx",
    "lint:fix": "eslint apps/ scripts/ tests/ eslint.config.ts --ext .ts,.tsx --fix",
    "typecheck": "bun run --filter '*' typecheck && bun run typecheck:root",
    "typecheck:root": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "test": "bun run --filter '*' test",
    "test:e2e": "bun tests/e2e/run.ts",
    "smoke": "playwright test -c tests/smoke/playwright.config.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run check:i18n && bun run check:env-docs && bun run check:api-docs && bun run check:api-spec && bun run check:api-types",
    "check:routes": "bun run --filter @app/api test .routes.test",
    "check:i18n": "bun scripts/check-i18n.ts",
    "check:env-docs": "bun scripts/gen-env-docs.ts --check",
    "check:api-docs": "bun run --filter @app/api check:api-docs",
    "check:api-spec": "bun run --filter @app/api check:api-spec",
    "check:api-types": "bun scripts/gen-api-types.ts --check",
    "gen:env-docs": "bun scripts/gen-env-docs.ts",
    "gen:api-docs": "bun run --filter @app/api gen:api-docs",
    "gen:api-spec": "bun run --filter @app/api gen:api-spec",
    "gen:api-types": "bun scripts/gen-api-types.ts",
    "seed": "bun run --filter @app/api seed",
    "package": "bun scripts/package.ts",
    "clean": "bun scripts/clean.ts",
    "clean:all": "bun scripts/clean.ts --all",
    "rebrand": "bun scripts/rebrand.ts",
    "hash-password": "bun scripts/hash-password.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@app/tsconfig": "workspace:*",
    "@eslint-react/eslint-plugin": "5.18.6",
    "@nsio/nsl": "0.1.7",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.0",
    "consola": "3.4.2",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "openapi-typescript": "7.13.0",
    "otpauth": "9.5.1",
    "typescript": "catalog:"
  },
  "overrides": {
    "esbuild": "^0.25.12",
    "@babel/core": "^7.29.7",
    "dompurify": "^3.4.14",
    "hono": "^4.13.5",
    "js-yaml": "^4.3.2",
    "protobufjs": "^7.6.6",
    "undici": "^7.29.0",
    "vite": "^8.2.2",
    "@univerjs/core": {
      "nanoid": "5.1.16"
    },
    "jsdom": {
      "undici": "^8.10.0"
    }
  }
}
