{
  // `tests/` needs its own program: the Playwright specs run browser-targeted
  // code (DOM lib) inside `page.addInitScript`. The root config deliberately
  // keeps those out of `scripts/`, which is Bun-only.
  "extends": "@app/tsconfig/react.json",
  "compilerOptions": {
    "types": ["bun"]
  },
  "include": ["**/*.ts"]
}
